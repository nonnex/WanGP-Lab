# WanGP-Lab root gitignore
# Track suite/. Do not commit wangp weights/venv/outputs.

# OS / editor
.DS_Store
Thumbs.db
*~
*.swp
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json

# Kilo local
.kilo/node_modules/
.kilo/package.json
.kilo/package-lock.json
.kilo/memory/local/
.kilo/agents/data.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Logs / temp
_logs/
*.log
*.tmp
*.bak
tmp/
.cache/

# Secrets
config/local.env
config/*.local.env
.env
.env.*
!.env.example
*.pem
*.key

# Suite runtime
data/experiments/
data/queues/
data/fixtures/**
!data/fixtures/.gitkeep
data/cache/_gate_frames_*/
data/cache/**/*.mp4

# Heavy binary defaults (re-allow mission cache below)
*.pt
*.pth
*.ckpt
*.safetensors
*.gguf
*.bin
*.onnx
*.whl
*.zip
*.7z
*.tar
*.tar.gz
*.npy
*.mp4
*.webm
*.mov
*.mkv
*.wav
*.mp3

# Mission assets in suite cache
!data/cache/wanmove/
!data/cache/wanmove/**
!data/cache/wanmove/**/*.jpg
!data/cache/wanmove/**/*.npy
!data/cache/wanmove/**/*.json
!data/cache/wanmove/**/*.md
!data/cache/wanmove/**/.gitkeep
!data/experiments/.gitkeep

# Nested WanGP clone — entirely local
wangp/

# Maps / build
**/*.js.map
*.pdf
**/*.o
**/*.so
.ipynb_checkpoints/
**/huggingface/
