# WanGP-Lab root gitignore
# Track suite/. Do not commit wangp weights/venv/outputs.

# OS / editor
.DS_Store
Thumbs.db
*~
*.swp
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json

# Kilo local
.kilo/node_modules/
.kilo/package.json
.kilo/package-lock.json
.kilo/memory/local/
.kilo/agents/data.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Logs / temp
_logs/
*.log
*.tmp
*.bak
tmp/
.cache/

# WanGP UI exports (suite-root; wangp/outputs → symlink)
_outputs/**
!_outputs/.gitkeep

# Secrets
config/local.env
config/*.local.env
.env
.env.*
!.env.example
*.pem
*.key

# Suite runtime
data/experiments/
data/queues/
data/fixtures/**
!data/fixtures/.gitkeep
data/cache/_gate_frames_*/
data/cache/**/*.mp4

# Heavy binary defaults (re-allow mission cache below)
*.pt
*.pth
*.ckpt
*.safetensors
*.gguf
*.bin
*.onnx
*.whl
*.zip
*.7z
*.tar
*.tar.gz
*.npy
*.mp4
*.webm
*.mov
*.mkv
*.wav
*.mp3

# Mission assets in suite cache (stills, tracks, minimal analysis)
!data/cache/wanmove/
!data/cache/wanmove/**
!data/cache/wanmove/**/*.jpg
!data/cache/wanmove/**/*.jpeg
!data/cache/wanmove/**/*.png
!data/cache/wanmove/**/*.npy
!data/cache/wanmove/**/*.npz
!data/cache/wanmove/**/*.json
!data/cache/wanmove/**/*.md
!data/cache/wanmove/**/.gitkeep
!data/experiments/.gitkeep

# Analysis bulk (rebuildable / not needed for tracks) — keep only sam3d_body.npz + meta
data/cache/wanmove/analysis/**/depth.npy
data/cache/wanmove/analysis/**/depth_vis.png
data/cache/wanmove/analysis/**/masks/
data/cache/wanmove/analysis/**/sam3_overlay.png
data/cache/wanmove/analysis/**/sam3d_overlay.png

# Nested WanGP clone — entirely local (includes .venv and rollback venvs)
wangp/

# Motor host tree (pose_gate + ~9GB venv) — local only, not git
/motor/

# Maps / build
**/*.js.map
*.pdf
**/*.o
**/*.so
.ipynb_checkpoints/
**/huggingface/
