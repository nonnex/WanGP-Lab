# WanGP-Lab suite paths (source from scripts)
# Primary names: WANGP_* / LAB_MOTOR_*
export WANGP_LAB_ROOT="/home/nick/AI/Projects/WanGP-Lab"
export WANGP_ROOT="${WANGP_ROOT:-$WANGP_LAB_ROOT/wangp}"

# Motor = pose_gate + SAM3D (real tree under workspace/motor/ — not a symlink).
# Override if needed: export LAB_MOTOR_ROOT=/other/path
export LAB_MOTOR_ROOT="${LAB_MOTOR_ROOT:-$WANGP_LAB_ROOT/motor}"

export WANGP_LAB_CACHE="$WANGP_LAB_ROOT/data/cache/wanmove"
export WANGP_LAB_EXPERIMENTS="$WANGP_LAB_ROOT/data/experiments"
# WanGP UI videos (wangp/outputs → symlink here)
export WANGP_LAB_OUTPUTS="$WANGP_LAB_ROOT/_outputs"
# keep current + previous run only (prune_experiments.sh / post-Move)
export WANGP_LAB_KEEP_RUNS="${WANGP_LAB_KEEP_RUNS:-2}"
# Active mission id (suite/missions/<id>/). e01 is default pack, not the only one.
export WANGP_LAB_MISSION="${WANGP_LAB_MISSION:-e01_uncross_open}"

# Host defaults: ~24GB RAM, RTX 5060 Ti 16GB
export WANGP_PROFILE="${WANGP_PROFILE:-4}"
export WANGP_ATTENTION="${WANGP_ATTENTION:-sage}"
export WANGP_PORT="${WANGP_PORT:-7860}"

# Legacy aliases (plugin / older tools) — do not set independently
export AIIMGSEQ_WANGP_ROOT="$WANGP_ROOT"
export AIIMGSEQ_LAB_ROOT="$LAB_MOTOR_ROOT"
